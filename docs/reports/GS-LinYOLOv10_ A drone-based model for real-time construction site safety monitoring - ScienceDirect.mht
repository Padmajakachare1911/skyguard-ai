img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-58"></use></g></g></svg></span></span> into their corresponding query, key, and value vectors.</div><div class="u-margin-s-bottom" id="d1e1508">Next, the keys and values are projected into lower-dimensional representations using projection matrices <span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG" id="MathJax-Element-35-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="2.581ex" height="2.317ex" viewBox="0 -747.2 1111.3 997.6" role="img" focusable="false" style="vertical-align: -0.582ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><g is="true"><use xlink:href="#MJMATHI-50"></use></g></g><g is="true" transform="translate(642,-150)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-6B"></use></g></g></g></g></svg></span></span> and <span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG" id="MathJax-Element-36-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="2.522ex" height="2.317ex" viewBox="0 -747.2 1085.8 997.6" role="img" focusable="false" style="vertical-align: -0.582ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><g is="true"><use xlink:href="#MJMATHI-50"></use></g></g><g is="true" transform="translate(642,-150)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-76"></use></g></g></g></g></svg></span></span>: <span class="display"><span id="fd5" class="formula"><span class="label">(5)</span><span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG"