"true"><use xlink:href="#MJMATHI-4B"></use></g></g><g is="true" transform="translate(901,410)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMAIN-2032"></use></g></g></g></g></svg></span></span>, followed by a softmax operation: <span class="display"><span id="fd6" class="formula"><span class="label">(6)</span><span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG" id="MathJax-Element-44-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="21.206ex" height="6.009ex" viewBox="0 -1542.1 9130.4 2587.3" role="img" focusable="false" style="vertical-align: -2.428ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><use xlink:href="#MJMATHI-41"></use></g><g is="true" transform="translate(1028,0)"><use xlink:href="#MJMAIN-3D"></use></g><g is="true" transform="translate(2084,0)"><use xlink:href="#MJMAIN-73"></use><use xlink:href="#MJMAIN-6F" x="394" y="0"></use><use xlink:href="#MJMAIN-66" x="895" y="0"></use><use xlink:href="#MJMAIN-74" x="1201" y="0"></use><use xlink:href="#MJMAIN-6D" x="1591" y="0"></use><use xlink:href="#MJMAIN-61" x="2424" y="0"></use><use xlink:href="#MJMAIN-78" x="2925" y="0"></use></g><g is="true" transform="translate(5538,0)"><use xlink:href="#MJSZ3-28"></use><g is="true" transform="translate(736,0)"><g is="true"><g transform="translate(120,0)"><rect stroke="none" width="1879" height="60" x="0" y="220"></rect><g is="true" transform="translate(60,541)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-51"></use></g><g is="true" transform="translate(559,0)"><g is="true"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-4B"></use></g></g><g is="true" transform="translate(637,290)"><g is="true"><use transform="scale(0.5)" xlink:href="#MJSSI-27"></use></g><g is="true" transform="translate(139,0)"><use transform="scale(0.5)" xlink:href="#MJMATHI-54"></use></g></g></g></g><g is="true" transform="translate(236,-566)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJSZ1-221A" x="0" y="25"></use><rect stroke="none" width="699" height="42" x="707" y="577"></rect><g transform="translate(707,0)"><g is="true"><g is="true"><g is="true"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-64"></use></g></g><g is="true" transform="translate(368,-107)"><g is="true"><use transform="scale(0.5)" xlink:href="#MJMATHI-6B"></use></g></g></g></g></g></g></g></g></g></g><use xlink:href="#MJSZ3-29" x="2855" y="-1"></use></g></g></g></svg></span></span></span></span>where <span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG" id="MathJax-Element-45-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.743ex" height="2.086ex" viewBox="0 -796.9 750.5 898.2" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-41"></use></g></g></svg></span></span><span> represents the attention <a href="https://www.sciencedirect.com/topics/engineering/score-matrix" class="topic-link">score matrix</a>, </span><span class="math"><span class="MathJax_Preview" style=""></span><span class="MathJax_SVG" id="MathJax-Element-46-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="2.298ex" height="2.317ex" viewBox="0 -747.2 989.3 997.6" role="img" focusable="false" style="vertical-align: -0.582ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><g is="true"><use xlink:href="#MJMATHI-64"></use></g></g><g is="true" transform="translate(520,-150)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMATHI-6B"></use></g></g></g></g></svg></span></span> is the dimensionality of the key vectors, and <span class="math"><span class="MathJax_Preview" style="display: none;"></span><span class="MathJax_SVG" id="MathJax-Element-47-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="3.941ex" height="2.548ex" viewBox="0 -995.6 1696.6 1096.9" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><g is="true"><use xlink:href="#MJMATHI-4B"></use></g></g><g is="true" transform="translate(901,410)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJSSI-27"></use></g><g is="true" transform="translate(196,0)"><use transform="scale(0.707)" xlink:href="#MJMATHI-54"></use></g></g></g></g></svg></span></span> denotes the transpose of the reduced keys.</div><div class="u-margin-s-bottom" id="d1e1706">Finally, the output is calculated by multiplying the attention scores <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">A</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-48-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.743ex" height="2.086ex" viewBox="0 -796.9 750.5 898.2" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-41"></use></g></g></svg></span></span> with the reduced values <span class="math"><span class="MathJax_Preview" style=""><math><msup is="true"><mrow is="true"><mi is="true">V</mi></mrow><mrow is="true"><mo is="true">â€²</mo></mrow></msup></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-49-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="2.602ex" height="2.317ex" viewBox="0 -896.2 1120.2 997.6" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><g is="true"><use xlink:href="#MJMATHI-56"></use></g></g><g is="true" transform="translate(825,410)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMAIN-2032"></use></g></g></g></g></svg></span></span>: <span class="display"><span id="fd7" class="formula"><span class="label">(7)</span><span class="math"><span class="MathJax_Preview" style=""><math><mrow is="true"><mi is="true">Z</mi><mo linebreak="goodbreak" is="true">=</mo><mi is="true">A</mi><msup is="true"><mrow is="true"><mi is="true">V</mi></mrow><mrow is="true"><mo is="true">â€²</mo></mrow></msup></mrow></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-50-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="9.124ex" height="2.317ex" viewBox="0 -896.2 3928.2 997.6" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><g is="true"><use xlink:href="#MJMATHI-5A"></use></g><g is="true" transform="translate(1001,0)"><use xlink:href="#MJMAIN-3D"></use></g><g is="true" transform="translate(2057,0)"><use xlink:href="#MJMATHI-41"></use></g><g is="true" transform="translate(2808,0)"><g is="true"><g is="true"><use xlink:href="#MJMATHI-56"></use></g></g><g is="true" transform="translate(825,410)"><g is="true"><use transform="scale(0.707)" xlink:href="#MJMAIN-2032"></use></g></g></g></g></g></svg></span></span></span></span>where <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">Z</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-51-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.68ex" height="1.971ex" viewBox="0 -747.2 723.5 848.5" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-5A"></use></g></g></svg></span></span> is the final output of the Linformer-based attention mechanism, representing the attended feature map that incorporates global information in a computationally efficient manner.</div><div class="u-margin-s-bottom" id="d1e1752"><a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#fig4" name="bfig4" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="fig4"><span class="anchor-text-container"><span class="anchor-text">Fig. 4</span></span></a><span><span> visually represents the Linformer-based attention mechanism, showing how it reduces the dimensionality of keys and values while maintaining global <a href="https://www.sciencedirect.com/topics/computer-science/context-awareness" class="topic-link">context awareness</a>. By reducing the complexity of the attention operation to linear in the input sequence length, Linformer enables GS-LinYOLOv10 to process large feature maps more efficiently. This is particularly advantageous for real-time applications, such as </span><a href="https://www.sciencedirect.com/topics/computer-science/drone-surveillance" class="topic-link">drone surveillance</a> in construction sites, where high-resolution input data must be processed quickly. Moreover, Linformer preserves critical contextual information while discarding redundant computations, ensuring that GS-LinYOLOv10 maintains high detection accuracy without requiring excessive computational resources.</span></div><div class="u-margin-s-bottom"><div id="d1e1757"><span>The efficiency achieved through Linformer-based attention allows GS-LinYOLOv10 to scale effectively in environments where large-scale, high-resolution inputs are common, such as construction sites. By retaining critical global context while minimizing redundant computations, Linformer enhances the modelâ€™s ability to detect objects across varying distances and handle <a href="https://www.sciencedirect.com/topics/computer-science/challenging-condition" class="topic-link">challenging conditions</a> like occlusions and complex spatial relationships.</span></div><figure class="figure text-xs" id="fig4"><span><img src="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-gr4.jpg" height="403" alt="" aria-describedby="d1e45"><ol class="u-margin-s-bottom"><li><a class="anchor download-link u-font-sans anchor-primary" href="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-gr4_lrg.jpg" target="_blank" download="" title="Download high-res image (350KB)"><span class="anchor-text-container"><span class="anchor-text">Download: <span class="download-link-title">Download high-res image (350KB)</span></span></span></a></li><li><a class="anchor download-link u-font-sans anchor-primary" href="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-gr4.jpg" target="_blank" download="" title="Download full-size image"><span class="anchor-text-container"><span class="anchor-text">Download: <span class="download-link-title">Download full-size image</span></span></span></a></li></ol></span><span class="captions text-s"><span id="d1e45"><p id="d1e46"><span class="label">Fig. 4</span>. Diagram of the Linformer attention mechanism, illustrating the process of applying scaled dot-product attention. The inputs <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">Q</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-52-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.838ex" height="2.432ex" viewBox="0 -796.9 791.5 1047.3" role="img" focusable="false" style="vertical-align: -0.582ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-51"></use></g></g></svg></span></span> (query), <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">K</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-53-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="2.066ex" height="1.971ex" viewBox="0 -747.2 889.5 848.5" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-4B"></use></g></g></svg></span></span> (key), and <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">V</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-54-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.787ex" height="1.971ex" viewBox="0 -747.2 769.5 848.5" role="img" focusable="false" style="vertical-align: -0.235ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMATHI-56"></use></g></g></svg></span></span> (value) go through linear projection layers, followed by scaled dot-product attention, optimizing efficiency in handling large sequences.</p></span></span></figure></div><div class="u-margin-s-bottom" id="d1e1761">In summary, the Linformer-based attention mechanism is a cornerstone of GS-LinYOLOv10, enabling the model to achieve high detection accuracy with reduced computational cost. This balance between efficiency and effectiveness ensures GS-LinYOLOv10 is well-suited for dynamic, resource-constrained applications, such as real-time drone-based monitoring in construction environments.</div></section></section><section id="sec4"><h2 id="d1e1766" class="u-h4 u-margin-l-top u-margin-xs-bottom">4. Expriments</h2><section id="sec4.1"><h3 id="d1e1771" class="rx-font-18 u-margin-m-top u-margin-xs-bottom">4.1. Dataset and preprocessing</h3><section id="sec4.1.1"><h4 id="d1e1776" class="u-margin-m-top u-margin-xs-bottom">4.1.1. Dataset</h4><div class="u-margin-s-bottom" id="d1e1778">To evaluate how well our GS-LinYOLOv10 model performs for drone-based construction site safety monitoring, we used two datasets: the COCO Dataset <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b52" name="bb52" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b52"><span class="anchor-text-container"><span class="anchor-text">[52]</span></span></a> and the Construction Site Safety Dataset <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b53" name="bb53" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b53"><span class="anchor-text-container"><span class="anchor-text">[53]</span></span></a>. These datasets include a wide range of images that reflect real-world scenarios relevant to our project. These datasets were chosen to ensure the model is trained and tested on diverse, real-world scenarios that reflect the complexity of construction site environments.</div><div class="u-margin-s-bottom" id="d1e1788">The COCO Dataset (Common Objects in Context) is a large-scale object detection dataset containing over 200,000 labeled images across 80 different object categories. It includes common objects like â€œpersonâ€, â€œvehicleâ€, â€œtruckâ€, and other items typically found on construction sites. The datasetâ€™s rich variety of scenes, including occluded objects, different weather conditions, and varying lighting scenarios, provides a strong foundation for generalizing the modelâ€™s detection capabilities in real-world environments. This dataset is essential for training our model to recognize everyday objects in complex and busy environments.</div><div class="u-margin-s-bottom" id="d1e1790">The Construction Site Safety Dataset is specifically designed for safety monitoring on construction sites. It consists of 2801 images labeled with 10 categories that are important for safety, such as â€œhardhatâ€, â€œsafety vestâ€, â€œmachineryâ€, and â€œperson.â€ These images come from real construction settings and are labeled to indicate whether safety rules are being followed, such as whether workers are wearing helmets or vests. The datasetâ€™s focus on safety-related categories makes it an invaluable resource for fine-tuning the modelâ€™s ability to detect hazards and ensure compliance with safety protocols.</div><div class="u-margin-s-bottom" id="d1e1792">By combining the COCO Datasetâ€™s general-purpose object detection capabilities with the safety-specific focus of the Construction Site Safety Dataset, GS-LinYOLOv10 benefits from both comprehensive detection performance and specialized safety monitoring capabilities. This dual-dataset approach enhances the modelâ€™s reliability in handling complex construction site environments, ensuring accurate detection of both general objects and safety-related items. Such robust detection is critical for real-time drone monitoring, where swift identification of potential hazards can significantly improve workplace safety.</div></section><section id="sec4.1.2"><h4 id="d1e1797" class="u-margin-m-top u-margin-xs-bottom">4.1.2. Data preprocessing</h4><div class="u-margin-s-bottom" id="d1e1799"><span>To make the GS-LinYOLOv10 model perform better and stay consistent, we used several <a href="https://www.sciencedirect.com/topics/computer-science/preprocessing-step" class="topic-link">preprocessing steps</a> on the datasets. First, we resized all images to 640 </span><span class="math"><span class="MathJax_Preview" style=""><math><mo is="true">Ã—</mo></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-55-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.808ex" height="1.394ex" viewBox="0 -548.5 778.5 600.2" role="img" focusable="false" style="vertical-align: 0.019ex; margin-bottom: -0.139ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMAIN-D7"></use></g></g></svg></span></span><span> 640 pixels, which is the input size needed for GS-LinYOLOv10. This resizing makes sure the images are small enough for fast processing but still have enough detail for the model to detect objects correctly. We also used <a href="https://www.sciencedirect.com/topics/computer-science/data-augmentation" class="topic-link">data augmentation</a> to make the training set more diverse, which helps the model learn better.</span></div><div class="u-margin-s-bottom" id="d1e1806">The data augmentation techniques included random cropping to mimic occlusions, horizontal flipping to account for different angles, and color changes to simulate different <a href="https://www.sciencedirect.com/topics/computer-science/lighting-condition" class="topic-link">lighting conditions</a><span>. These adjustments help the model become stronger and work well in changing environments. We also applied slight rotations and scaling to simulate different views, which is useful for drone-based monitoring systems that capture images from various angles. All pixel values were normalized to be between 0 and 1 by dividing by 255. This makes the data uniform and helps the model learn faster. During augmentation, the <a href="https://www.sciencedirect.com/topics/engineering/bounding-box" class="topic-link">bounding boxes</a> of objects were also adjusted so they match the transformations, keeping the object labels correct even after the changes like cropping or rotation. The purpose of all these steps is to expose the GS-LinYOLOv10 model to different object looks and conditions so it can handle new, unseen situations better. This is particularly important for monitoring construction sites, which have lots of movement and changes.</span></div><div class="u-margin-s-bottom" id="d1e1808">With this approach, combining well-prepared datasets and thorough preprocessing, the GS-LinYOLOv10 model is ready to tackle the challenging and constantly changing environment of construction sites, helping to detect common objects and safety hazards more effectively.</div></section></section><section id="sec4.2"><h3 id="d1e1813" class="rx-font-18 u-margin-m-top u-margin-xs-bottom">4.2. Implementation details</h3><div class="u-margin-s-bottom" id="d1e1815">The experiments were conducted using the hardware and software described in <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#tbl1" name="btbl1" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="tbl1"><span class="anchor-text-container"><span class="anchor-text">Table 1</span></span></a>, which details the experimental environment used for training and testing the GS-LinYOLOv10 model.</div><div class="u-margin-s-bottom"><div id="d1e1821">The GS-LinYOLOv10 model was trained using the MOCS and CIS datasets, as described in Section <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#sec4.1" name="bsec4.1" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="sec4.1"><span class="anchor-text-container"><span class="anchor-text">4.1</span></span></a>. All images were resized to 640 <span class="math"><span class="MathJax_Preview" style=""><math><mo is="true">Ã—</mo></math></span><span class="MathJax_SVG MathJax_SVG_Processed" id="MathJax-Element-56-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"><svg xmlns:xlink="http://www.w3.org/1999/xlink" width="1.808ex" height="1.394ex" viewBox="0 -548.5 778.5 600.2" role="img" focusable="false" style="vertical-align: 0.019ex; margin-bottom: -0.139ex;"><g stroke="currentColor" fill="currentColor" stroke-width="0" transform="matrix(1 0 0 -1 0 0)"><g is="true"><use xlink:href="#MJMAIN-D7"></use></g></g></svg></span></span> 640 pixels to ensure compatibility with the model input requirements. The choice of this resolution balances computational efficiency with the retention of important details for accurate object detection.</div><div class="tables colsep-0 frame-topbot rowsep-0" id="tbl1"><span class="captions text-s"><span id="d1e92"><p id="d1e93"><span class="label">Table 1</span>. Experimental Environment.</p></span></span><div class="groups"><table><thead><tr class="rowsep-1 valign-top"><th scope="col" class="align-left">Parameter</th><th scope="col" class="align-left">Description</th></tr></thead><tbody><tr class="valign-top"><th class="align-left" scope="row">Hardware</th><td class="align-left">NVIDIA A100 GPU, 40GB VRAM</td></tr><tr class="valign-top"><th class="align-left" scope="row">Software</th><td class="align-left">Python 3.8, PyTorch 1.8, CUDA 11.0</td></tr><tr class="valign-top"><th class="align-left" scope="row">Operating System</th><td class="align-left">Ubuntu 20.04</td></tr><tr class="valign-top"><th class="align-left" scope="row">Memory</th><td class="align-left">128 GB RAM</td></tr><tr class="valign-top"><th class="align-left" scope="row">Disk Storage</th><td class="align-left">2TB SSD</td></tr></tbody></table></div></div></div><div class="u-margin-s-bottom" id="d1e1837"><span><span>A batch size of 16 was used during training to optimize the use of <a href="https://www.sciencedirect.com/topics/engineering/graphics-processing-unit" class="topic-link">GPU</a> memory and maintain fast training iterations. The initial </span><a href="https://www.sciencedirect.com/topics/computer-science/learning-rate" class="topic-link">learning rate</a> was set to 0.001, with a learning rate scheduler employed to adjust the rate dynamically. Specifically, the learning rate was reduced by a factor of 0.1 when the validation loss did not improve for 10 consecutive epochs, helping the model converge more effectively in later stages of training. The </span><a href="https://www.sciencedirect.com/topics/computer-science/adam-optimizer" class="topic-link">Adam optimizer</a><span> was chosen for its <a href="https://www.sciencedirect.com/topics/computer-science/adaptive-learning-rate" class="topic-link">adaptive learning rate</a> properties, which make it particularly suitable for object detection tasks with complex data, such as construction site images. The optimizer adjusts the learning rate individually for each parameter, improving stability during training and helping avoid large gradient updates that could destabilize the model. Training was carried out for a maximum of 50 epochs, with early stopping implemented to prevent overfitting. Early stopping was triggered if the validation loss failed to improve for 10 consecutive epochs. This mechanism prevented overfitting while ensuring the model maintained its ability to generalize to unseen data. Early stopping is particularly crucial in real-world scenarios where the model must perform robustly under varying environmental conditions, such as changes in lighting, weather, and occlusions.</span></div><div class="u-margin-s-bottom" id="d1e1839"><span>To better illustrate the training process, we summarize the key steps of GS-LinYOLOv10â€™s training pipeline in Algorithm 1. This <a href="https://www.sciencedirect.com/topics/engineering/pseudocode" class="topic-link">pseudocode</a><span> provides an overview of how the datasets are processed, how features are extracted and learned using the GSConv module and Linformer-based attention mechanism, and how performance metrics such as precision, recall, and <a href="https://www.sciencedirect.com/topics/computer-science/mean-average-precision" class="topic-link">mean Average Precision</a> (mAP) are used to evaluate the model during training. </span></span><span class="display"><figure class="figure text-xs" id="dfig1"><span><img src="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-fx1001.jpg" height="701" alt=""><ol class="u-margin-s-bottom"><li><a class="anchor download-link u-font-sans anchor-primary" href="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-fx1001_lrg.jpg" target="_blank" download="" title="Download high-res image (662KB)"><span class="anchor-text-container"><span class="anchor-text">Download: <span class="download-link-title">Download high-res image (662KB)</span></span></span></a></li><li><a class="anchor download-link u-font-sans anchor-primary" href="https://ars.els-cdn.com/content/image/1-s2.0-S1110016825000304-fx1001.jpg" target="_blank" download="" title="Download full-size image"><span class="anchor-text-container"><span class="anchor-text">Download: <span class="download-link-title">Download full-size image</span></span></span></a></li></ol></span></figure></span></div></section><section id="sec4.3"><h3 id="d1e1853" class="rx-font-18 u-margin-m-top u-margin-xs-bottom">4.3. Evaluation metrics</h3><div class="u-margin-s-bottom" id="d1e1855">In this evaluation, several standard metrics are employed to assess the performance of the GS-LinYOLOv10 model in object detection tasks. These metrics are widely used to measure the modelâ€™s accuracy, precision, recall, and efficiency in detecting objects in complex environments.</div><div class="u-margin-s-bottom" id="d1e1857">Precision: Precision measures the proportion of correctly predicted positive samples out of all samples predicted as positive. It is defined as: <span class="display"><span id="fd8" class="formula"><span class="label">(8)</span><span class="math"><span class="MathJax_Preview" style=""><math><mrow is="true"><mtext is="true">Precision</mtext><mo linebreak="goodbreak" is="true">=</mo><mfrac is="true"><mrow is="true"><mtext is="true">TP</mtext></mrow><mrow is="true"><mtext is="true">TP</mtext><mo linebreak="badbreak" is="true">+</mo><mtext is="true">FP</mtext></mrow></mfrac></mrow></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-57-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span></span></span><span>where TP is the number of <a href="https://www.sciencedirect.com/topics/computer-science/true-positive" class="topic-link">true positives</a>,</span></div><div class="u-margin-s-bottom" id="d1e1884">FP is the number of <a href="https://www.sciencedirect.com/topics/computer-science/false-positive" class="topic-link">false positives</a>.</div><div class="u-margin-s-bottom" id="d1e1886">Recall: Recall, also known as sensitivity, measures the proportion of actual positive samples that were correctly identified by the model. It is defined as: <span class="display"><span id="fd9" class="formula"><span class="label">(9)</span><span class="math"><span class="MathJax_Preview" style=""><math><mrow is="true"><mtext is="true">Recall</mtext><mo linebreak="goodbreak" is="true">=</mo><mfrac is="true"><mrow is="true"><mtext is="true">TP</mtext></mrow><mrow is="true"><mtext is="true">TP</mtext><mo linebreak="badbreak" is="true">+</mo><mtext is="true">FN</mtext></mrow></mfrac></mrow></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-58-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span></span></span>where TP is the number of true positives,</div><div class="u-margin-s-bottom" id="d1e1913">FN is the number of <a href="https://www.sciencedirect.com/topics/computer-science/false-negative" class="topic-link">false negatives</a>.</div><div class="u-margin-s-bottom" id="d1e1915"><span>F1-Score: The F1-Score is the harmonic mean of precision and recall. It provides a balanced metric that considers both false positives and <a href="https://www.sciencedirect.com/topics/engineering/false-negative" class="topic-link">false negatives</a>, and it is particularly useful when dealing with imbalanced datasets. It is computed as: </span><span class="display"><span id="fd10" class="formula"><span class="label">(10)</span><span class="math"><span class="MathJax_Preview" style=""><math><mrow is="true"><mi is="true">F</mi><mn is="true">1</mn><mo linebreak="goodbreak" is="true">=</mo><mn is="true">2</mn><mo linebreak="goodbreak" is="true">Ã—</mo><mfrac is="true"><mrow is="true"><mtext is="true">Precision</mtext><mo linebreak="badbreak" is="true">Ã—</mo><mtext is="true">Recall</mtext></mrow><mrow is="true"><mtext is="true">Precision</mtext><mo linebreak="badbreak" is="true">+</mo><mtext is="true">Recall</mtext></mrow></mfrac></mrow></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-59-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span></span></span>where Precision and Recall are calculated using the above formulas.</div><div class="u-margin-s-bottom" id="d1e1952">Mean Average Precision (mAP): mAP is the primary metric used to evaluate object detection models. It calculates the average precision (AP) for each class and then computes the mean across all object classes. AP is derived from the precisionâ€“recall curve by calculating the area under the curve (AUC). The mAP provides an overall measure of the modelâ€™s ability to detect objects across all categories: <span class="display"><span id="fd11" class="formula"><span class="label">(11)</span><span class="math"><span class="MathJax_Preview" style=""><math><mrow is="true"><mtext is="true">mAP</mtext><mo linebreak="goodbreak" is="true">=</mo><mfrac is="true"><mrow is="true"><mn is="true">1</mn></mrow><mrow is="true"><mi is="true">N</mi></mrow></mfrac><munderover is="true"><mrow is="true"><mo linebreak="badbreak" is="true">âˆ‘</mo></mrow><mrow is="true"><mi is="true">i</mi><mo linebreak="badbreak" is="true">=</mo><mn is="true">1</mn></mrow><mrow is="true"><mi is="true">N</mi></mrow></munderover><msub is="true"><mrow is="true"><mtext is="true">AP</mtext></mrow><mrow is="true"><mi is="true">i</mi></mrow></msub></mrow></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-60-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span></span></span>where <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">N</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-61-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span> is the number of object classes and <span class="math"><span class="MathJax_Preview" style=""><math><msub is="true"><mrow is="true"><mtext is="true">AP</mtext></mrow><mrow is="true"><mi is="true">i</mi></mrow></msub></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-62-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span> is the average precision for class <span class="math"><span class="MathJax_Preview" style=""><math><mi is="true">i</mi></math></span><span class="MathJax_SVG MathJax_SVG_Processing" id="MathJax-Element-63-Frame" tabindex="0" style="font-size: 90%; display: inline-block;"></span></span>.</div><div class="u-margin-s-bottom" id="d1e2017">Inference Time (Frames Per Second): It is critical in evaluating the modelâ€™s efficiency in real-time applications. It measures how many frames the model can process per second. Higher FPS indicates faster processing and is particularly important for real-time scenarios like drone-based surveillance on construction sites.</div><div class="u-margin-s-bottom" id="d1e2019">Latency: In addition to FPS, inference latency (in milliseconds) is measured to determine the time taken by the model to process a single frame. Low latency is crucial for ensuring rapid responses in time-sensitive applications, such as detecting safety hazards on construction sites. These metrics emphasize the practicality of the GS-LinYOLOv10 model in real-world applications.</div></section><section id="sec4.4"><h3 id="d1e2024" class="rx-font-18 u-margin-m-top u-margin-xs-bottom">4.4. Ablation study</h3><div class="u-margin-s-bottom" id="d1e2026">In the ablation study, we systematically tested the contributions of the key components in GS-LinYOLOv10 by running a series of controlled experiments. First, we replaced the SCDown module in the original YOLOv10 with the lightweight GSConv module to measure its impact on inference speed and model efficiency. Next, we integrated the Linformer-based attention mechanism in place of the standard MSHA to evaluate its effect on detection performance, particularly in complex environments. Finally, we combined both modifications â€” GSConv and Linformer â€” to form the full GS-LinYOLOv10 model, examining how these components work together to improve both accuracy and efficiency. Each experiment was performed under the same conditions to ensure a <a href="https://www.sciencedirect.com/topics/computer-science/fair-comparison" class="topic-link">fair comparison</a>.</div></section></section><section id="sec5"><h2 id="d1e2031" class="u-h4 u-margin-l-top u-margin-xs-bottom">5. Results and discussion</h2><section id="sec5.1"><h3 id="d1e2036" class="rx-font-18 u-margin-m-top u-margin-xs-bottom">5.1. Comparison with the state-of-the-art</h3><div class="u-margin-s-bottom" id="d1e2038">As presented in <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#tbl2" name="btbl2" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="tbl2"><span class="anchor-text-container"><span class="anchor-text">Table 2</span></span></a><span>, the performance comparison between various YOLO-based models on the COCO Dataset and the Construction Site Safety Dataset demonstrates clear differences in detection precision, recall, F1-score, and <a href="https://www.sciencedirect.com/topics/computer-science/mean-average-precision" class="topic-link">mAP</a><span> across different models. These metrics highlight the <a href="https://www.sciencedirect.com/topics/materials-science/mechanical-strength" class="topic-link">strengths</a><span> and limitations of each model in handling diverse and complex real-world scenarios. From the table, we observe that GS-LinYOLOv10 outperforms all other models, achieving a precision of 91.2% on the COCO dataset and 92.1% on the Kaggle dataset. The modelâ€™s high F1-scores (90 on COCO and 90.8 on Kaggle) and mAP50 scores (89.4% on COCO and 90.3% on Kaggle) indicate its robust ability to balance precision and recall, making it highly effective for detecting objects across various categories. Its significant improvements can be attributed to the integration of the GSConv module and Linformer-based attention mechanism, which enhance feature extraction efficiency and global <a href="https://www.sciencedirect.com/topics/computer-science/context-awareness" class="topic-link">context awareness</a>. YOLO-v4 also shows strong performance, with an mAP50 of 78.6% on the COCO dataset and 80.8% on the Kaggle dataset. Although it ranks below GS-LinYOLOv10, YOLO-v4 demonstrates consistent robustness, particularly for detecting larger objects and handling moderate levels of complexity. This consistency highlights its continued relevance in real-time object detection tasks. On the other hand, models such as YOLO-DS and Improved YOLOv3 exhibit lower performance metrics, especially in terms of mAP50-95, suggesting challenges in detecting objects under stricter IoU thresholds or in more complex scenarios. GSO-YOLO, while competitive, falls behind GS-LinYOLOv10 in both precision and recall, achieving only 76.3% precision and 70.4% mAP50 on COCO. These results indicate that older or less optimized models may struggle with complex, dynamic environments like construction sites, where accurate detection is critical. In particular, the Kaggle dataset results emphasize GS-LinYOLOv10â€™s superiority in safety-related object detection tasks, such as identifying helmets, vests, and machinery. The modelâ€™s precision and recall on this dataset underscore its capability to meet the practical demands of real-time safety monitoring. In summary, GS-LinYOLOv10 exhibits the best overall performance, making it the most suitable model for construction site safety monitoring. Its superior detection accuracy, high precision, and ability to handle complex object categories highlight its effectiveness in addressing the challenges of dynamic environments and ensuring reliable safety monitoring.</span></span></span></div><div class="u-margin-s-bottom"><div id="d1e2044"> <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#tbl3" name="btbl3" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="tbl3"><span class="anchor-text-container"><span class="anchor-text">Table 3</span></span></a><span> presents a comparison of several YOLO-based models in terms of their computational efficiency and inference speed on both the COCO Dataset and the Construction Site Safety Dataset. The table includes <a href="https://www.sciencedirect.com/topics/engineering/key-performance-indicator" class="topic-link">key performance indicators</a> such as the number of parameters, FLOPs, latency (in milliseconds), and inference speed (in frames per second, FPS). From the table, it is evident that GS-LinYOLOv10 not only achieves the best performance in terms of latency and inference speed, but it also maintains a balanced computational complexity with 10.72 million parameters and 38.93 GFLOPs. GS-LinYOLOv10 exhibits a latency of 9.81 ms on the COCO dataset, which is the lowest among the models compared, and achieves a high inference speed of 92.41 FPS. Its results on the Kaggle dataset are similarly strong, with a latency of 10.5 ms and an FPS of 91.8, further highlighting its suitability for real-time applications. CaSnLi-YOLO and edge-YOLO also demonstrate impressive results in terms of speed. CaSnLi-YOLO achieves a high FPS of 90.32 on the COCO dataset and 88.1 on the Kaggle dataset, making it one of the fastest models, with a relatively low latency of 10.23 ms on the COCO dataset. edge-YOLO, despite having fewer parameters (8.34M) and fewer FLOPs (28.71 GFLOPs), shows respectable latency and FPS, with values of 11.43 ms and 88.22 FPS on the COCO dataset, demonstrating its efficiency in resource-constrained environments. On the other hand, models such as YOLO-v4 and Improved YOLOv3 have the highest computational complexity in terms of FLOPs and parameters. YOLO-v4 has 45.23 GFLOPs and 13.53M parameters, resulting in a relatively high latency of 14.12 ms and a lower inference speed of 75.83 FPS on the COCO dataset. Similarly, Improved YOLOv3 experiences a latency of 13.33 ms and an FPS of 80.11. In conclusion, GS-LinYOLOv10 proves to be the best performer in both latency and inference speed across the two datasets, striking an optimal balance between computational efficiency and detection speed. Its ability to deliver high-speed inference with moderate computational complexity makes it an ideal choice for real-time, time-sensitive environments such as construction site monitoring.</span></div><div class="tables colsep-0 frame-topbot rowsep-0" id="tbl2"><span class="captions text-s"><span id="d1e133"><p id="d1e134"><span class="label">Table 2</span>. Performance comparison on COCO and Kaggle Construction Site Safety datasets.</p></span></span><div class="groups"><table><thead><tr class="valign-top"><th scope="col" class="align-left">Models</th><th scope="col" class="align-left rowsep-1" colspan="5">COCO dataset</th><th scope="col" class="align-left rowsep-1" colspan="5">Kaggle construction site safety dataset</th></tr><tr class="rowsep-1 valign-top"><td scope="col" class="align-left"><span class="screen-reader-only">Empty Cell</span></td><th scope="col" class="align-left">Precision</th><th scope="col" class="align-left">Recall</th><th scope="col" class="align-left">F1-Score</th><th scope="col" class="align-left">mAP50</th><th scope="col" class="align-left">mAP50â€“95</th><th scope="col" class="align-left">Precision</th><th scope="col" class="align-left">Recall</th><th scope="col" class="align-left">F1-Score</th><th scope="col" class="align-left">mAP50</th><th scope="col" class="align-left">mAP50-95</th></tr></thead><tbody><tr class="valign-top"><th class="align-left" scope="row">GSO-YOLO <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b54" name="bb54" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b54"><span class="anchor-text-container"><span class="anchor-text">[54]</span></span></a></th><td class="align-left">76.3</td><td class="align-left">72.4</td><td class="align-left">74.2</td><td class="align-left">70.4</td><td class="align-left">45.1</td><td class="align-left">78.4</td><td class="align-left">74.6</td><td class="align-left">76.3</td><td class="align-left">73.5</td><td class="align-left">46.3</td></tr><tr class="valign-top"><th class="align-left" scope="row">CaSnLi-YOLO <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b55" name="bb55" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b55"><span class="anchor-text-container"><span class="anchor-text">[55]</span></span></a></th><td class="align-left">80.1</td><td class="align-left">75.7</td><td class="align-left">77.3</td><td class="align-left">72.4</td><td class="align-left">50.1</td><td class="align-left">82.3</td><td class="align-left">78.5</td><td class="align-left">79.4</td><td class="align-left">76.4</td><td class="align-left">52.1</td></tr><tr class="valign-top"><th class="align-left" scope="row">edge-YOLO <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b56" name="bb56" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b56"><span class="anchor-text-container"><span class="anchor-text">[56]</span></span></a></th><td class="align-left">82.3</td><td class="align-left">79.4</td><td class="align-left">80.2</td><td class="align-left">75.2</td><td class="align-left">55.3</td><td class="align-left">85.6</td><td class="align-left">81.5</td><td class="align-left">83.1</td><td class="align-left">79.2</td><td class="align-left">56.4</td></tr><tr class="valign-top"><th class="align-left" scope="row">Improved yolov3 <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b56" name="bb56" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b56"><span class="anchor-text-container"><span class="anchor-text">[56]</span></span></a></th><td class="align-left">78.1</td><td class="align-left">74.3</td><td class="align-left">76.2</td><td class="align-left">72.3</td><td class="align-left">48.4</td><td class="align-left">80.4</td><td class="align-left">77.3</td><td class="align-left">78.2</td><td class="align-left">74.6</td><td class="align-left">50.3</td></tr><tr class="valign-top"><th class="align-left" scope="row">YOLO-v4 <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b57" name="bb57" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b57"><span class="anchor-text-container"><span class="anchor-text">[57]</span></span></a></th><td class="align-left">84.5</td><td class="align-left">80.7</td><td class="align-left">82.4</td><td class="align-left">78.6</td><td class="align-left">60.2</td><td class="align-left">87.4</td><td class="align-left">83.2</td><td class="align-left">85.1</td><td class="align-left">80.8</td><td class="align-left">62.3</td></tr><tr class="valign-top"><th class="align-left" scope="row">YOLO-DS <a class="anchor anchor-primary" href="https://www.sciencedirect.com/science/article/pii/S1110016825000304?ref=pdf_download&amp;fr=RR-2&amp;rr=a2439b1b7e3d4206#b58" name="bb58" data-sd-ui-side-panel-opener="true" data-xocs-content-type="reference" data-xocs-content-id="b58"><span class="anchor-text-container"><span class="anchor-text">[58]</span></span></a></th><td class="align-left">79.4</td><td class="align-left">76.3</td><td class="align-left">77.4</td><td class="align-left">74.5</td><td class="align-left">50.4</td><td class="align-left">81.5</td><td class="align-left">79.6</td><td class="align-left">80.4</td><td class="align-left">75.8</td><td class="align-left">51.2</td></tr><tr class="valign-top"><th class="align-left" scope="row">GS-LinYOLOv10</th><td class="align-left">91.2</td><td class="align-left">88.9</td><td class="align-left">90</td><td class="align-left">89.4</td><td class="align-left">72.1</td><td class="align-left">92.1</td><td class="align-left">89.5</td><td class="align-left">90.8</td><td class="align-left">90.3</td><td class="align-left">74.2</td></tr></tbody><